  "narrative": {
    "northStar": "The Trilogy Shelf",
    "overview": "This descriptive label captures the incumbent system: three recognizable classic covers against a sober charcoal background, with a clear route into the selected game. It records the implemented direction rather than a separately approved concept or visual exploration.\n\nThe launcher is a native Win32 application drawn with GDI+, with standard Windows controls in its utility dialogs. Condensed headings give the games presence; regular body text keeps configuration and installation readable. The original motorcycle masthead supports the covers without becoming the primary attraction. The user-confirmed commitments are the dark background and classic covers.",
    "keyCharacteristics": [
      "Classic cover art leads the visual hierarchy.",
      "Warm text and a restrained yellow accent sit on charcoal surfaces.",
      "Square, flat controls keep the interface direct.",
      "Native Windows interaction remains visible and usable.",
      "English labels describe local actions and actual game readiness."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Yellow identifies the chosen game and the main action. Keep settings and supporting copy visually quieter.",
        "section": "colors"
      },
      {
        "name": "The Legibility Rule",
        "body": "Condensed bold belongs to short headings and game names. Keep instructions, field values and longer text in regular Barlow.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the three-cover hierarchy and original cover proportions.",
      "Do reserve yellow emphasis for selection and the primary action.",
      "Do retain visible keyboard focus and native dialog navigation.",
      "Do keep the motorcycle masthead subordinate to the games.",
      "Do write English labels that explain the current local state."
    ],
    "donts": [
      "Don't replace classic covers with generated reinterpretations.",
      "Don't stretch or crop a cover to fill its card.",
      "Don't introduce decorative shadows or rounded cards into the flat shell.",
      "Don't let artwork obscure headings, status or controls.",
      "Don't imply network play, official service unlocks or complete campaign validation."
    ]
  }
